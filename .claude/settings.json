{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode":"plan",
    "allow": [
        "Bash(npm run lint)",
        "Bash(npm test)",
        "Bash(npx tsc --noEmit)",
        "Bash(npm run build)"
    ],
    "ask": [
        "Bash(npm install)",
        "Bash(git push *)",
        "Bash(rm *)"
    ],
    "deny": [
        "Read(.env*)",
        "Bash(sudo *)",
        "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-after-edit.sh\"",
            "timeout": 120,
            "statusMessage": "lint とテストを実行中..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/notify-stop.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}